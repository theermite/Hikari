{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hikari",
  "version": "0.3.0",
  "identifier": "com.theermite.hikari",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hikari",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": [
      "binaries/hikari-engine"
    ],
    "resources": {
      "obs-runtime/": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3RTg1NTM4MEZCRDdFMDgKUldRSWZyMFBPRlhvbDlHSkhGTlNaaEU5anFKb01xZ1MrajE1Y0hiOXVXL2lSUEJnMWpUSVhKOTAK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
