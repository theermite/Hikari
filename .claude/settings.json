{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" memory/memory-recall.py",
            "description": "Plan pt3 - rappel de memoire avant une commande (rappelle, ne bloque jamais)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/bash-guard.py",
            "description": "All Bash guards: secrets, destructive, commits, deploy, migrations, deps"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/session-start-mandatory-read.py",
            "description": "Block first state-mutating tool until MANDATORY FIRST READ files are read"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/obsidian-mandatory-read.py",
            "description": "Block first state-mutating tool until 4 Obsidian project notes are loaded via vault_read"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/docs-progress-update.py",
            "description": "Warn on git commit feat/fix without today's session report"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/atomic-commit-check.py",
            "description": "Warn on git commit spanning >= 3 distinct scopes (atomic commit heuristic)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/doc-facts-check.py",
            "description": "Plan pt7 - refuse un commit qui emporte un fait faux sur nous-memes"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/agents-park-check.py",
            "description": "Plan pt2 - refuse un commit qui fait deriver le parc d experts"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/anti-quick-fix.py",
            "description": "Block git commit fix:/hotfix: without [ROBUSTNESS] (6 mois / cause racine / alternative durable) or [ROBUSTNESS-SKIP] motif"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" deploy/smoke-test-required.py",
            "description": "Warn when a deploy command runs without a subsequent smoke test"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/pre-deploy-vault-check.py",
            "description": "D2 — Block deploy when env vars from docs/architecture/env-vars.md are missing in Vault"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/pre-deploy-registry-check.py",
            "description": "D3 — Block deploy when docs/registry/ has uncommitted changes"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/pre-infra-drift-check.py",
            "description": "D3-infra — Block deploy when Shinkofa-Infra registry drifts from live VPS (check-drift.py)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" deploy/maintenance-pages-check.py",
            "description": "Warn if deploy proceeds without nginx 502/503/504 maintenance pages"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" deploy/safari-test-required.py",
            "description": "Warn on public deploy without .browserslistrc or [SAFARI-OK]/[SAFARI-SKIP] marker"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" deploy/axe-violations.py",
            "description": "Warn on public deploy without [AXE-OK]/[AXE-SKIP] marker"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" deploy/a11y-checks.py",
            "description": "Warn on public deploy when CSS lacks prefers-reduced-motion or touch-target rules"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" time-tracker/estimation-capture.py",
            "description": "Capture time-estimation phrases (e.g. 'ca prendra 10 min') to estimations.jsonl"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/pre-push-drift-check.py",
            "description": "Warn (never block) on methodology drift vs MNK-GoRin before git push (D1 brick 2)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/pre-deploy-review-check.py",
            "description": "Block a deploy or a methodology propagation without a [REVIEW] marker from an independent context (or a [REVIEW-SKIP] with a closed-enum motif)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/post-review-cause-check.py",
            "description": "After a review verdict FAIL, block the next commit unless it carries [CAUSE] (famille / cause / ce qui empeche la repetition); at the 2nd failure in a row, also require a changed approach"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/pre-bash-secret-mask.py",
            "description": "Rewrite suspicious commands (docker exec/compose config, ssh+docker/env, cat .env, printenv) to mask secrets in OUTPUT before it reaches the conversation"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/write-guard.py",
            "description": "All Write/Edit guards: env, JWT, secrets, SHA pin, naming"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/pre-code-veille-check.py",
            "description": "Veille / SKB evidence guard: block source code writes without [VEILLE]/[SKB]/[VEILLE-SKIP] marker"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/session-start-mandatory-read.py",
            "description": "Block first state-mutating tool until MANDATORY FIRST READ files are read"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/obsidian-mandatory-read.py",
            "description": "Block first state-mutating tool until 4 Obsidian project notes are loaded via vault_read"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" memory/rules-vs-memory.py",
            "description": "Warn when Takumi cites methodology rules from memory instead of source files"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/reformulate-gate.py",
            "description": "Block 2nd Write|Edit in same turn without REFORMULATION marker"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/tdg-test-first.py",
            "description": "Warn on source code write with no sibling test (TDG)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/logs-first.py",
            "description": "Warn on Edit after failed Bash without log Read between (LOGS FIRST)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/veille-extended.py",
            "description": "Block docs/Audits|Decisions|Research writes without [VEILLE]/[SKB]/[VEILLE-SKIP] marker"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lego/shinkofa-ui-inventory.py",
            "description": "Warn when a React component named like @shinkofa/ui inventory is defined without importing from the package"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lego/morphic-decoy-check.py",
            "description": "Block a hand-drawn comfort-settings panel (3+ adaptation axes, no @theermite/morphic-* reference); warn at 2 axes. Reads HTML mockups too."
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lego/i18n-no-hardcode.py",
            "description": "Warn on hardcoded UI strings in .tsx/.jsx (use @shinkofa/i18n)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lego/shared-types-only.py",
            "description": "Warn on local redeclaration of types shared via @shinkofa/types"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" time-tracker/estimation-capture.py",
            "description": "Capture time-estimation phrases on Write|Edit too (observability — never blocks)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/matter-expert-suggest.py",
            "description": "Plan pt1 - convocation par la matiere (suggere, ne bloque jamais)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/challenge-trace-check.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/post-write-guard.py",
            "description": "All post-write guards: file size, BOM, console.log"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/utf8-french-check.py",
            "description": "Warn on French .md content with unaccented words (UTF-8 regression)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/function-complexity-check.py",
            "description": "Maintainability: block Python functions > 30 lines or cyclomatic complexity > 10 (F1)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" memory/memory-autocommit.py",
            "description": "Regle Memoire - commet + pousse le souvenir ET ses sommaires dans Shinzo"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/post-commit-push-check.py",
            "description": "D1 — Warn after git commit when branch is ahead of upstream (unpushed)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/post-bash-secret-alert.py",
            "description": "Warn (never block) when a secret survived into a Bash command output the pre-hook did not wrap"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/agent-invocation-journal.py",
            "description": "Plan pt1 - journal des invocations d agents (observe, ne bloque jamais)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/time-awareness.py",
            "description": "Inject [TIME] YYYY-MM-DD HH:MM Europe/Madrid CET|CEST at each user prompt"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/simple-language-inject.py",
            "description": "Option A — Inject Simple Language violations from previous Stop hook into Takumi's next context (functional BLOCKING for Stop hook)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/clock-not-fatigue-inject.py",
            "description": "Option A — Inject clock-is-not-fatigue violation from previous Stop hook into Takumi's next context (Identity.md 'The Clock Is Not a Fatigue Signal')"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" guards/pre-session-end-readme-check.py",
            "description": "D4 — Warn at /session-end when README appears out of sync (new commands, manifests, breaking changes)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/context-gauge.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/hook-health-check.py",
            "description": "Sonde de sante des garde-fous — annonce, ne bloque jamais"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" time-tracker/realtime-tracker.py",
            "description": "Record started_at for the session (time tracker)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/session-start-obsidian.py",
            "description": "SessionStart reminder: load 4 mandatory Obsidian project notes (companion to obsidian-mandatory-read.py)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/session-start-handoff.py"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/notes-globales.py",
            "description": "Les notes globales de Jay (Shinzo 08-Notes) remontent dans Takumi — une fois par changement, jamais bloquant"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/relay-inbox.py",
            "description": "Plan pt8 - remonte les messages des autres sessions, en donnee jamais en ordre"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/notes-jay-markers.py",
            "description": "Count Notes-Jay items without status markers and surface summary"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" time-tracker/realtime-tracker.py",
            "description": "Append session duration to sessions.jsonl (time tracker)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" time-tracker/session-report-stats.py",
            "description": "Write last-session-stats.md and emit one-line ratio summary"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/session-end-metrics.py",
            "description": "Write objective session metrics (unpushed commits, TODO/FIXME, veille markers) to .claude/state/last-session-metrics.md"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/state-cleanup.py",
            "description": "Archive handoff briefs older than 7 days into .claude/state/_archive/"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/hook-blocks-stats.py",
            "description": "A2 — Count hook blocks/warns per signature to .claude/state/hook-blocks.jsonl (guardrail-fatigue meter, never blocks)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/simple-language-check.py",
            "description": "Scan Takumi's last response for Simple Language violations (Honesty.md, WARN only)"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" quality/clock-not-fatigue-check.py",
            "description": "Scan Takumi's last response for clock-is-not-fatigue violations (Identity.md 'The Clock Is Not a Fatigue Signal', WARN + next-turn injection)"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/pre-compact-handoff.py",
            "description": "Auto-snapshot handoff brief before compaction (auto-resume architecture)"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/post-compact-recheck.py",
            "description": "Surface handoff brief path after compaction (non-blocking, WARN only)"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/agent-invocation-journal.py",
            "description": "Plan pt1 - journal des invocations d agents (observe, ne bloque jamais)"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/_run.sh\" lifecycle/agent-invocation-journal.py",
            "description": "Plan pt1 - journal des invocations d agents (observe, ne bloque jamais)"
          }
        ]
      }
    ]
  }
}
