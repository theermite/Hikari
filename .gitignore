# --- Rust / Cargo ---
/target/
**/target/
*.pdb
Cargo.lock.bak

# --- Tauri ---
/src-tauri/target/
/src-tauri/gen/
/src-tauri/WixTools/
/src-tauri/binaries/

# --- Moteur OBS embarqué ---
# Les binaires OBS sont récupérés au build/à l'exécution, jamais versionnés (ils pèsent
# des centaines de Mo et ont leur propre distribution). Voir la brique installation.
/obs-runtime/
/src-tauri/obs-runtime/
# Cache de `cargo obs-build` : l'archive OBS décompressée, re-téléchargeable à volonté.
/src-tauri/obs-build/
/libobs/
*.dll
*.so
*.dylib
# Données de plugins écrites par le runtime OBS à l'exécution (rtmp-services, win-capture,
# etc.) quand le moteur tourne — régénérables, jamais du code. Non ancré à la racine :
# le moteur les écrit dans son répertoire courant (racine, src-tauri/, spikes/…).
rtmp-services/
win-capture/

# --- Node / front ---
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- Secrets : rien de sensible ne doit jamais partir ici ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# --- Sorties de spike (code jetable, mesures brutes) ---
# Les spikes B0.x produisent des relevés et des fichiers encodés lourds.
# Les MESURES sont reportées dans le plan d'exécution ; les artefacts restent locaux.
/spikes/**/out/
/spikes/**/*.mp4
/spikes/**/*.mkv
/spikes/**/*.flv
# OBS compilé et serveur RTMP de test : téléchargés/reconstruits par le spike, des
# centaines de Mo. Jamais dans l'historique d'un dépôt public (leçon Kobo 2026-07-28).
/spikes/**/obs-build/
/spikes/**/mediamtx/
/spikes/**/*.zip

# --- Éditeurs / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# --- Divers ---
coverage/
*.log

# Python bytecode — jamais committe (2026-07-17)
__pycache__/
*.pyc

# Hook state (machine-local) — never propagate, never stash
.claude/state/
